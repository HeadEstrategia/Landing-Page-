{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protege-chassi.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.html)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/valida-tokens.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git init:*)",
      "Bash(git remote -v)",
      "Bash(git config --global --list)",
      "Bash(git --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(gh --version)",
      "Bash(gh auth status:*)",
      "Bash(vercel --version)",
      "Bash(vercel whoami:*)",
      "Bash(vercel link:*)",
      "Bash(vercel ls:*)",
      "Bash(vercel inspect:*)",
      "Bash(node scripts/liberar-acesso.js:*)",
      "Bash(node scripts/preparar-dominio.js:*)",
      "Bash(cp .env.example .env)",
      "Bash(open index.html)",
      "Bash(open blocos/index.html)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel remove:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel tokens:*)",
      "Bash(vercel domains:*)",
      "Bash(vercel dns:*)"
    ]
  }
}
